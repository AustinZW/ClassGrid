<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_today_title"
        android:textColor="#24242C"
        android:textStyle="bold"
        android:textSize="18sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_preview_day_date"
        android:textColor="#625E6C"
        android:textSize="12sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:layout_width="4dp" android:layout_height="34dp"
            android:background="#6750A4" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_course_one" android:textColor="#6750A4"
                android:textStyle="bold" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_time_one" android:textColor="#625E6C"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:layout_width="4dp" android:layout_height="34dp"
            android:background="#006A6A" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_course_two" android:textColor="#006A6A"
                android:textStyle="bold" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_time_two" android:textColor="#625E6C"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:layout_width="4dp" android:layout_height="34dp"
            android:background="#984061" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_course_three" android:textColor="#984061"
                android:textStyle="bold" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_time_three" android:textColor="#625E6C"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
