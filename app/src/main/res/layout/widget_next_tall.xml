<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">
    <TextView
        android:id="@+id/widget_day_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_today_title"
        android:textColor="#24242C"
        android:textStyle="bold"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/widget_day_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_preview_day_date"
        android:textColor="#625E6C"
        android:textSize="12sp" />
    <ListView
        android:id="@+id/widget_day_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="2dp"
        android:scrollbars="none" />
    <TextView
        android:id="@+id/widget_day_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="@string/widget_today_empty"
        android:textColor="#625E6C"
        android:textSize="14sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_day_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#625E6C"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
